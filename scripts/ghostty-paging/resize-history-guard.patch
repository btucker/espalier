+test "incremental decode discards history after a width round trip" {
+    const testing = std.testing;
+    var t = try testHistoryTerminal(2);
+    defer t.deinit(testing.allocator);
+    var encoded: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer encoded.deinit();
+    try encode(testing.allocator, &encoded.writer, &t, test_encode_options);
+
+    var source: std.Io.Reader = .fixed(encoded.written());
+    var decoder: Decoder = .init(&source);
+    var decoded = try decoder.ready(testing.allocator, testing.io, test_decode_options);
+    defer decoded.deinit(testing.allocator);
+    var restored = decoded.toOwned();
+    defer restored.deinit(testing.allocator);
+
+    try restored.resize(testing.allocator, .{ .cols = 3, .rows = 3 });
+    try restored.resize(testing.allocator, .{ .cols = 2, .rows = 3 });
+    const total = restored.screens.get(.primary).?.pages.total_rows;
+    var pages: usize = 0;
+    while (try decoder.next(testing.allocator, &restored)) |progress| {
+        try testing.expectEqual(0, progress.rows);
+        pages += 1;
+    }
+    try testing.expectEqual(2, pages);
+    try testing.expectEqual(total, restored.screens.get(.primary).?.pages.total_rows);
 }

+test "incremental decode preserves pending history when reflow requires recovery" {
+    const testing = std.testing;
+    var t = try testHistoryTerminal(2);
+    defer t.deinit(testing.allocator);
+    var encoded: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer encoded.deinit();
+    try encode(testing.allocator, &encoded.writer, &t, test_encode_options);
+
+    for (0..4) |scenario| {
+        var source: std.Io.Reader = .fixed(encoded.written());
+        var decoder: Decoder = .init(&source);
+        var decoded = try decoder.ready(testing.allocator, testing.io, test_decode_options);
+        defer decoded.deinit(testing.allocator);
+        var restored = decoded.toOwned();
+        defer restored.deinit(testing.allocator);
+        if (scenario == 2) {
+            const first = (try decoder.nextAtOriginalWidth(testing.allocator, &restored)).?;
+            try testing.expectEqual(2, first.rows);
+        }
+        const offset = source.seek;
+        try restored.resize(testing.allocator, .{ .cols = if (scenario == 3) 1 else 3, .rows = 3 });
+        if (scenario == 1) try restored.resize(testing.allocator, .{ .cols = 2, .rows = 3 });
+        const total = restored.screens.get(.primary).?.pages.total_rows;
+        for (0..3) |_| {
+            try testing.expectError(error.HistoryRequiresRecovery, decoder.nextAtOriginalWidth(testing.allocator, &restored));
+            const manifest_bytes: usize = if (scenario == 2) 0 else record.Header.len + history.Header.len;
+            try testing.expectEqual(offset + manifest_bytes, source.seek);
+            try testing.expectEqual(total, restored.screens.get(.primary).?.pages.total_rows);
+        }
+        // A recovery result does not poison the decoder. An explicit discard
+        // can still validate and drain the untouched original records.
+        var remaining: usize = 0;
+        while (try decoder.next(testing.allocator, &restored)) |progress| {
+            try testing.expectEqual(0, progress.rows);
+            remaining += 1;
+        }
+        try testing.expectEqual(@as(usize, if (scenario == 2) 1 else 2), remaining);
+    }
+}
